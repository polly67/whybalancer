# ==============================================================================
# AUTONOMOUS HOT-STANDBY RELAY ARCHITECTURE - DYNAMIC ENVIRONMENT CONFIGURATION
# Zero hardcoded values: all settings driven by environment variables with fallbacks.
# ==============================================================================

# --- MOCK CHAT SERVER CONFIGURATION ---
PORT=3000
HOST=0.0.0.0
WS_PATH=/chat
HEALTH_PATH=/health
METRICS_PATH=/metrics
MESSAGES_PATH=/messages
EVENTS_PATH=/events
RESET_PATH=/reset
MAX_HISTORY_SIZE=5000

# --- BOT WORKER CORE CONFIGURATION ---
# Worker identifier (defaults to dynamically generated worker-<pid>-<rand>)
WORKER_ID=
# Initial state: ACTIVE or STANDBY (defaults to auto-detection or STANDBY)
INITIAL_MODE=STANDBY
# Target chat server endpoint
SERVER_URL=http://127.0.0.1:3000
# WebSocket stream endpoint (defaults to SERVER_URL + WS_PATH)
WS_URL=ws://127.0.0.1:3000/chat

# --- DISTRIBUTED STORE & HEARTBEAT (REDIS / UPSTASH REST) ---
# Standard Redis TCP connection URL (local or cloud)
REDIS_URL=redis://127.0.0.1:6379
# Optional key prefix for all Redis keys
REDIS_KEY_PREFIX=relay:
# Upstash Redis REST API (optional alternative for serverless/ephemeral runners)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Heartbeat key name in key-value store
HEARTBEAT_KEY=relay:heartbeat
# Frequency at which active worker emits heartbeat (ms)
HEARTBEAT_INTERVAL_MS=1000
# Key TTL in seconds (automatically expires if worker process dies ungracefully)
HEARTBEAT_TTL_SEC=3
# Frequency at which standby worker polls the heartbeat key (ms)
STANDBY_POLL_INTERVAL_MS=500
# Inactivity threshold before standby initiates failover promotion (ms)
HEARTBEAT_TIMEOUT_MS=2500

# --- EPHEMERAL LIFECYCLE & SELF-REPLICATION TIMINGS ---
# Maximum execution duration in seconds (GitHub Actions ceiling: 21600 / 6h)
# Set to fast testing value (e.g. 30 or 60) for local accelerated demo
MAX_RUN_DURATION_SEC=21600
# Pre-warm lead time buffer in seconds (spawns replacement runner before expiration)
# Set to fast testing value (e.g. 10 or 15) for local accelerated demo
PRE_WARM_BUFFER_SEC=1200
# Optional shell command executed by active worker when pre-warm threshold is hit
PRE_WARM_COMMAND=

# --- SRE LOAD GENERATOR & CHAOS BENCHMARK ---
TARGET_URL=http://127.0.0.1:3000
RATE_PER_SECOND=25
DURATION_SEC=30
CHAOS_INJECTION_DELAY_SEC=10
CHAOS_TYPE=SIGTERM
CHAOS_TARGET_PID=
BENCHMARK_OUTPUT_FORMAT=table

# --- PHASE 2: DISCORD RELAY & GITHUB DISPATCH CONFIGURATION ---
DISCORD_BOT_TOKEN=
GH_DISPATCH_TOKEN=
GITHUB_REPOSITORY=
GITHUB_API_URL=https://api.github.com
DISPATCH_EVENT_TYPE=spawn-standby
PRE_WARM_MINUTES=340
RUN_LIMIT_MINUTES=359
ACCELERATED_MODE=false
PRE_WARM_SECONDS=15
RUN_LIMIT_SECONDS=30

# --- DEBUG & OBSERVABILITY TOGGLES ---
DEBUG_HEARTBEAT=false
DEBUG_STANDBY=false
DEBUG_MESSAGES=false
DEBUG_STORE=false
